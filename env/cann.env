# 昇腾算子模拟环境 —— 版本与路径约定
# 这个文件同时被 env/wsl/*.sh（source）与 scripts/ascend.ps1（解析 KEY=VALUE）读取。
# 修改版本后： scripts/ascend.ps1 bootstrap  （重装 CANN）-> scripts/ascend.ps1 doctor

CANN_VERSION=9.0.0
CANN_TOOLKIT_URL=https://ascend-repo.obs.cn-east-2.myhuaweicloud.com/CANN/CANN%209.0.0/Ascend-cann-toolkit_9.0.0_linux-x86_64.run
CANN_INSTALL_PATH=/usr/local/Ascend

# WSL 发行版（由 scripts/ascend.ps1 bootstrap 用 rootfs 导入，不依赖微软商店）
WSL_DISTRO=AscendCANN
WSL_ROOTFS_URL=https://mirrors.tuna.tsinghua.edu.cn/ubuntu-cloud-images/wsl/jammy/current/ubuntu-jammy-wsl-amd64-ubuntu22.04lts.rootfs.tar.gz
WSL_IMPORT_DIR=E:\wsl\AscendCANN

# 工作区：Windows 路径 -> WSL 路径；脚本会在 WSL 内建 ASCII 软链 /work
WORKSPACE_WIN=E:\projects\昇腾社区
WORKSPACE_WSL=/mnt/e/projects/昇腾社区
WORKSPACE_LINK=/work

# 目标 NPU 架构：dav-2201 = Atlas A2/A3 系列；dav-3510 = Ascend 950 系列
ASC_ARCH=dav-2201
